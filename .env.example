# Desenvolvimento local: SQLite, zero setup.
# Produção: troque o provider para "postgresql" em prisma/schema.prisma e
# aponte para seu Postgres real (Neon, Supabase, RDS...).
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório forte em produção.
SESSION_SECRET="troque-este-valor-em-producao"

