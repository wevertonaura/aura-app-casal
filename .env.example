# Postgres (Supabase). DATABASE_URL = pooler em transaction mode (porta
# 6543, usado em runtime/serverless). DIRECT_URL = conexão direta (porta
# 5432, só o Prisma Migrate usa).
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Segredo usado para assinar o cookie de sessão. Gere um valor aleatório forte em produção.
SESSION_SECRET="troque-este-valor-em-producao"

# --- WhatsApp (UAZAPI — https://docs.uazapi.com) ---
# Server URL da sua instância (o painel uazapiGO mostra isso pra você).
UAZAPI_BASE_URL="https://SEU-SUBDOMINIO.uazapi.com"
# Token da instância conectada (não confundir com o Admin Token, que só
# serve pra criar/gerenciar instâncias).
UAZAPI_INSTANCE_TOKEN=
# Só necessário se algum dia formos criar instâncias via API.
# UAZAPI_ADMIN_TOKEN=

# --- IA (não usada no MVP, pronta para o futuro) ---
# AI_API_KEY=

# Protege /api/cron/bill-reminders (lembrete de conta fixa 3 dias antes de
# vencer) contra chamadas de fora. Gere um valor aleatório e configure o
# mesmo valor no agendador (Vercel Cron já manda esse header sozinho).
# CRON_SECRET=
