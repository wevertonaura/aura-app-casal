// Schema do AURA — MVP de gestão financeira para casais.
//
// Datasource: em desenvolvimento local usamos SQLite (zero setup) via
// DATABASE_URL="file:./dev.db". Para produção, troque `provider` para
// "postgresql" e aponte DATABASE_URL para o Postgres real (Neon, Supabase,
// RDS, etc.) — o schema abaixo não usa nenhum recurso exclusivo de SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  avatarUrl         String?
  monthlyIncome     Decimal  @default(0)
  whatsappConnected Boolean  @default(false)
  whatsappNumber    String?
  // Verificação por código enviado via WhatsApp — evita que alguém digite o
  // número de outra pessoa e receba as mensagens/dados financeiros dela.
  whatsappPendingNumber String?
  whatsappVerifyCode    String?
  whatsappVerifyExpires DateTime?
  createdAt         DateTime @default(now())

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id])

  sessions Session[]
  expenses Expense[]

  @@index([coupleId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CoupleMode {
  conjunto
  individual
}

model Couple {
  id            String     @id @default(cuid())
  inviteCode    String     @unique
  leisureBudget Decimal    @default(0)
  // "conjunto" = pensado pra casal (padrão); "individual" = uma pessoa só,
  // sem convite de parceiro(a). Mesmo modelo de dados nos dois casos — o
  // modo individual é só um "casal" de uma pessoa. Preço por modo fica
  // pra decidir depois (ver PricingToggle) — este campo só guarda a escolha.
  mode          CoupleMode @default(conjunto)
  createdAt     DateTime   @default(now())

  users            User[]
  expenses         Expense[]
  fixedBills       FixedBill[]
  debts            Debt[]
  goals            Goal[]
  whatsappMessages WhatsappMessage[]
  categories       Category[]
}

enum ExpenseSource {
  app
  whatsapp
}

model Expense {
  id          String        @id @default(cuid())
  description String
  amount      Decimal
  // String livre em vez de enum: as 5 categorias padrão (alimentacao,
  // transporte, lazer, compras, outros) usam essas chaves em minúsculo por
  // compatibilidade com o parser da Aura no WhatsApp; categorias criadas
  // pelo casal na aba Gastos guardam o nome exatamente como digitado.
  category    String
  date        DateTime
  source      ExpenseSource @default(app)
  createdAt   DateTime      @default(now())

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([coupleId])
  @@index([userId])
}

/// Categorias de gasto criadas pelo casal, além das 5 padrão (que não
/// precisam de registro aqui — só existem em código).
model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([coupleId, name])
}

enum FixedBillCategory {
  aluguel
  agua
  luz
  internet
  academia
  assinatura
  parcela
  outro
}

model FixedBill {
  id                 String            @id @default(cuid())
  name               String
  amount             Decimal
  category           FixedBillCategory
  totalInstallments  Int? // null = conta recorrente sem prazo (aluguel, luz, etc.)
  // Dia do mês em que a conta vence (1-31, truncado pra meses mais curtos —
  // ver `nextDueDate` em lib/calc.ts). Usado pra calcular quando disparar o
  // lembrete no WhatsApp.
  dueDay             Int               @default(5)
  startDate          DateTime          @default(now())
  createdAt          DateTime          @default(now())

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  reminders FixedBillReminder[]

  @@index([coupleId])
}

/// Registra que já mandamos o lembrete de vencimento pra uma competência
/// específica (mês/dia) de uma conta — evita mandar a mesma mensagem duas
/// vezes se o cron rodar mais de uma vez no dia.
model FixedBillReminder {
  id      String   @id @default(cuid())
  dueDate DateTime
  sentAt  DateTime @default(now())

  fixedBillId String
  fixedBill   FixedBill @relation(fields: [fixedBillId], references: [id], onDelete: Cascade)

  @@unique([fixedBillId, dueDate])
}

model Debt {
  id             String   @id @default(cuid())
  name           String
  totalAmount    Decimal
  monthlyPayment Decimal
  startDate      DateTime @default(now())
  createdAt      DateTime @default(now())

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  payments DebtPayment[]

  @@index([coupleId])
}

/// Um pagamento registrado contra uma dívida específica — a soma desses
/// valores é quanto já foi quitado (Debt.totalAmount - pago = restante).
model DebtPayment {
  id        String   @id @default(cuid())
  amount    Decimal
  date      DateTime
  createdAt DateTime @default(now())

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

model Goal {
  id           String   @id @default(cuid())
  name         String
  targetAmount Decimal
  targetDate   DateTime
  savedAmount  Decimal  @default(0)
  createdAt    DateTime @default(now())

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

enum MessageDirection {
  in
  out
}

model WhatsappMessage {
  id          String            @id @default(cuid())
  direction   MessageDirection
  text        String
  relatedType String? // expense | fixedbill | debt | goal | query | none
  createdAt   DateTime          @default(now())

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}
